# Kapso
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=
KAPSO_PUBLIC_WHATSAPP_NUMBER=
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp

# AI SDK
# Providers: openai | anthropic | opencode
AI_PROVIDER=opencode
AI_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1

# Storage/runtime
DATA_DIR=./data
PORT=3000

# Optional reminder template for messages outside the WhatsApp 24h window
KAPSO_REMINDER_TEMPLATE_NAME=
