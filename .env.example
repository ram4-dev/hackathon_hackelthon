# ─── Supabase (capa de datos · SPEC-00 §3/§7) ───────────────────────────────
# Si están seteadas, lib/deps.ts usa la db real (lib/db.ts → Supabase).
# Si faltan, corre el mock en memoria (harness/demo andan sin base).
# SERVICE_ROLE_KEY es SOLO server-side (RLS off en el MVP).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Kapso (transporte WhatsApp · SPEC-00 §7 / SPEC-B) ───────────────────────
# Si KAPSO_API_KEY + KAPSO_PHONE_NUMBER_ID están seteadas, lib/deps.ts usa el
# transporte real (lib/kapso.ts). Si faltan, usa el mock que loguea.
KAPSO_API_KEY=
KAPSO_WEBHOOK_SECRET=
KAPSO_PHONE_NUMBER_ID=
KAPSO_PUBLIC_WHATSAPP_NUMBER=
KAPSO_BASE_URL=https://api.kapso.ai/meta/whatsapp
# Template para mensajes fuera de la ventana de 24 h (opcional)
KAPSO_REMINDER_TEMPLATE_NAME=

# ─── LLM (el agente · AI SDK) ────────────────────────────────────────────────
# Provider: anthropic (default) | openai | opencode
# Modelo: LLM_MODEL tiene prioridad sobre AI_MODEL; default por provider.
AI_PROVIDER=opencode
AI_MODEL=deepseek-v4-flash
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# Timeout defensivo del loop del agente (ms)
AGENT_TIMEOUT_MS=90000

# ─── Runtime ─────────────────────────────────────────────────────────────────
DATA_DIR=./data
PORT=3000
